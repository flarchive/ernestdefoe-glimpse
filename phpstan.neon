includes:
    - vendor/flarum/phpstan/extension.neon
    - vendor/phpstan/phpstan-strict-rules/rules.neon

parameters:
    # One process: flarum/phpstan's bootstrap installs a test forum the first time it runs, and
    # parallel workers would each start that install at once.
    parallel:
        maximumNumberOfProcesses: 1
    level: max
    paths:
        - extend.php
        - src
    # Optional extensions' classes, which aren't installed here.
    scanFiles:
        - tests/phpstan/optional-extensions.stub
    strictRules:
        # Eloquent builders forward static-looking methods through __call: every query trips this.
        dynamicCallOnStaticMethod: false
